# Параметры запуска MCP-серверов 1С в Docker.
# Скопируйте этот файл рядом с docker-compose.yml под именем .env и поправьте значения.
#   Linux:   cp .env.example .env
#   Windows: copy .env.example .env

# ОБЯЗАТЕЛЬНО. Абсолютный путь к каталогу XML-выгрузки исходников 1С.
# Внутри должны быть подкаталоги Configuration (основная конфигурация)
# и, опционально, Extensions/<ИмяРасширения> (расширения).
# Этот же каталог пробрасывается и в metadata-loader (/data/src), и в mcp-bsl-checker (/src).
#
# Пример для Linux (в том числе Astra Linux):
SRC_1C_DIR=/home/user/projects/proj1/1c-src
# Пример для Windows (слеши только прямые, буква диска с двоеточием):
# SRC_1C_DIR=D:/projects/proj1/1c-src

# Режим отслеживания изменений XML-файлов в metadata-loader.
# 1 - опрос файловой системы (обязательно для Windows и сетевых каталогов),
# 0 - нативные события файловой системы (быстрее, подходит для Linux с локальным диском).
WATCHER_POLLING=1
