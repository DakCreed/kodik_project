# Пакеты OneScript, устанавливаемые через opm по packagedef
oscript_modules/

# Результаты сборки и выгрузки
build/
out/
*.ospx
*.cf
*.cfe
*.epf
*.dt

# Локальные переменные окружения (пути, адреса, параметры запуска)
.env

# Поставка MCP-серверов от Infostart: лицензионные материалы издателя
# (документация, обработка выгрузки) не должны попадать в публичный репозиторий.
# Исключения ниже - только наши собственные файлы настроек.
mcp/*
!mcp/DEPLOY-astra-linux.md
!mcp/mcp_v1.6.3/
mcp/mcp_v1.6.3/*
!mcp/mcp_v1.6.3/docker-compose.yml
!mcp/mcp_v1.6.3/.env.example
!mcp/mcp_v1.6.3/bsl-ls/
mcp/mcp_v1.6.3/bsl-ls/*
!mcp/mcp_v1.6.3/bsl-ls/.bsl-language-server.json

# Логи и временные файлы
*.log
tmp/
temp/

# Отчёты тестов и покрытия
allure-results/
build/out/
coverage/

# Служебные файлы ОС и редакторов
Thumbs.db
desktop.ini
.DS_Store
.idea/
